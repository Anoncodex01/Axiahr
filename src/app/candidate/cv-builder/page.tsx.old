'use client';

import { useState, useEffect, Suspense } from 'react';
import { useSearchParams } from 'next/navigation';
import CandidateLayout from '@/components/CandidateLayout';
import { 
  Crown,
  Sparkles,
  Download,
  Upload,
  CreditCard,
  ExternalLink,
  CheckCircle,
  Star,
  Zap,
  Shield,
  Clock,
  DollarSign,
  Loader2,
  RefreshCw,
  FileText,
  Calendar,
  Plus
} from 'lucide-react';

export default function CVBuilderPage() {
  return (
    <CandidateLayout>
      <Suspense fallback={<div className="min-h-screen bg-gray-50 flex items-center justify-center"><Loader2 className="w-8 h-8 animate-spin text-[#114373]" /></div>}>
        <CVBuilderContent />
      </Suspense>
    </CandidateLayout>
  );
}

function CVBuilderContent() {
  const searchParams = useSearchParams();
  const [showPaymentModal, setShowPaymentModal] = useState(false);
  const [showUploadModal, setShowUploadModal] = useState(false);
  const [showSuccessModal, setShowSuccessModal] = useState(false);
  const [successMessage, setSuccessMessage] = useState('');
  const [successType, setSuccessType] = useState<'payment' | 'upload'>('payment');
  const [selectedFile, setSelectedFile] = useState<File | null>(null);
  const [isProcessingPayment, setIsProcessingPayment] = useState(false);
  const [isUploading, setIsUploading] = useState(false);
  const [isLoadingOrder, setIsLoadingOrder] = useState(true);
  const [candidateId, setCandidateId] = useState<string | null>(null);
  const [amountTZS, setAmountTZS] = useState(50000);
  const [amountUSD, setAmountUSD] = useState(0);
  const [formattedTZS, setFormattedTZS] = useState('TZS 50,000');
  const [formattedUSD, setFormattedUSD] = useState('$0.00');
  const [orderStatus, setOrderStatus] = useState<{
    hasOrder: boolean;
    orders: Array<{
      id: number;
      candidateName?: string;
      candidateEmail?: string;
      paymentStatus: string;
      canUpload: boolean;
      hasProcessedCv: boolean;
      cvFilePath?: string;
      processedCvPath?: string;
      createdAt: string;
      paidAt?: string;
      completedAt?: string;
      amountTZS: number;
      amountUSD: number;
      status: string;
    }>;
    latestOrder: {
      paymentStatus: string;
      canUpload: boolean;
      hasProcessedCv: boolean;
      cvFilePath?: string;
      processedCvPath?: string;
    } | null;
  } | null>(null);

  // Get candidate ID from localStorage
  useEffect(() => {
    const token = localStorage.getItem('authToken');
    if (token) {
      try {
        const payload = JSON.parse(atob(token.split('.')[1]));
        setCandidateId(payload.sub || payload.candidateId || null);
      } catch (error) {
        // Error parsing token
      }
    }
  }, []);

  // Calculate USD amount based on exchange rate
  useEffect(() => {
    // Fetch exchange rate from API to match backend calculation
    const fetchExchangeRate = async () => {
      try {
        const response = await fetch('/api/cv-builder/exchange-rate');
        if (response.ok) {
          const data = await response.json();
          const rate = data.rate || 2678; // Default to 2678 if API fails
          const usd = amountTZS / rate;
          setAmountUSD(usd);
          setFormattedTZS(new Intl.NumberFormat('en-TZ', {
            style: 'currency',
            currency: 'TZS',
            minimumFractionDigits: 0,
            maximumFractionDigits: 0
          }).format(amountTZS));
          setFormattedUSD(new Intl.NumberFormat('en-US', {
            style: 'currency',
            currency: 'USD',
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }).format(usd));
        } else {
          // Fallback to default rate
          const defaultRate = 2678;
          const usd = amountTZS / defaultRate;
          setAmountUSD(usd);
          setFormattedTZS(new Intl.NumberFormat('en-TZ', {
            style: 'currency',
            currency: 'TZS',
            minimumFractionDigits: 0,
            maximumFractionDigits: 0
          }).format(amountTZS));
          setFormattedUSD(new Intl.NumberFormat('en-US', {
            style: 'currency',
            currency: 'USD',
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }).format(usd));
        }
      } catch (error) {
        // Fallback to default rate on error
        const defaultRate = 2678;
        const usd = amountTZS / defaultRate;
        setAmountUSD(usd);
        setFormattedTZS(new Intl.NumberFormat('en-TZ', {
          style: 'currency',
          currency: 'TZS',
          minimumFractionDigits: 0,
          maximumFractionDigits: 0
        }).format(amountTZS));
        setFormattedUSD(new Intl.NumberFormat('en-US', {
          style: 'currency',
          currency: 'USD',
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }).format(usd));
      }
    };

    fetchExchangeRate();
  }, [amountTZS]);

  // Fetch order status function
  const fetchOrderStatus = async () => {
    if (!candidateId) {
      setIsLoadingOrder(false);
      return;
    }

    try {
      const token = localStorage.getItem('authToken');
      const response = await fetch('/api/cv-builder/order-status', {
        headers: {
          'Authorization': `Bearer ${token}`
        }
      });

      if (response.ok) {
        const data = await response.json();
        if (data.success && data.hasOrder) {
          setOrderStatus({
            hasOrder: true,
            orders: data.orders || [],
            latestOrder: data.latestOrder
          });
        } else {
          setOrderStatus({
            hasOrder: false,
            orders: [],
            latestOrder: null
          });
        }
      }
    } catch (error) {
      // Error fetching order status
    } finally {
      setIsLoadingOrder(false);
    }
  };

  // Fetch order status on mount and when candidateId changes
  useEffect(() => {
    fetchOrderStatus();
    
    // Poll for order status updates (in case webhook hasn't fired yet)
    const interval = setInterval(() => {
      if (candidateId && orderStatus?.latestOrder?.paymentStatus === 'pending') {
        fetchOrderStatus();
      }
    }, 5000); // Check every 5 seconds

    return () => clearInterval(interval);
  }, [candidateId]);

  // Handle payment success/cancel from URL params
  useEffect(() => {
    const paymentStatus = searchParams.get('payment');
    const sessionId = searchParams.get('session_id');

    if (paymentStatus === 'success' && sessionId) {
      // Refresh order status after payment
      setTimeout(() => {
        const fetchOrderStatus = async () => {
          try {
            const token = localStorage.getItem('authToken');
            const response = await fetch('/api/cv-builder/order-status', {
              headers: {
                'Authorization': `Bearer ${token}`
              }
            });

            if (response.ok) {
              const data = await response.json();
              if (data.success && data.hasOrder) {
                setOrderStatus({
                  hasOrder: true,
                  orders: data.orders || [],
                  latestOrder: data.latestOrder
                });
              }
            }
          } catch (error) {
            // Error fetching order status
          }
        };
        fetchOrderStatus();
      }, 2000); // Wait 2 seconds for webhook to process

      setSuccessMessage('Payment successful! You can now upload your CV for professional processing.');
      setSuccessType('payment');
      setShowSuccessModal(true);
      setShowPaymentModal(false);
      // Clean URL
      window.history.replaceState({}, '', '/candidate/cv-builder');
    } else if (paymentStatus === 'cancelled') {
      alert('Payment was cancelled. You can try again anytime.');
      // Clean URL
      window.history.replaceState({}, '', '/candidate/cv-builder');
    }
  }, [searchParams]);

  const handleFileUpload = (event: React.ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0];
    if (file) {
      setSelectedFile(file);
    }
  };

  const handlePayment = async () => {
    const token = localStorage.getItem('authToken');
    if (!token) {
      alert('Please log in to continue with payment.');
      return;
    }

    setIsProcessingPayment(true);
    try {
      // Try to get candidateId from token if not available
      let candidateIdToSend = candidateId;
      if (!candidateIdToSend) {
        try {
          const payload = JSON.parse(atob(token.split('.')[1]));
          candidateIdToSend = payload.sub || payload.candidateId || payload.id;
        } catch (error) {
          // Error parsing token
        }
      }

      const response = await fetch('/api/cv-builder/create-payment', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify(candidateIdToSend ? { candidateId: candidateIdToSend } : {})
      });

      const data = await response.json();

      if (response.ok && data.success && data.url) {
        // Redirect to Stripe Checkout
        window.location.href = data.url;
      } else {
        alert(data.error || 'Failed to create payment session. Please try again.');
        setIsProcessingPayment(false);
      }
    } catch (error: any) {
      alert('An error occurred. Please try again.');
      setIsProcessingPayment(false);
    }
  };

  const handleUploadCV = async () => {
    if (!selectedFile) {
      alert('Please select a file to upload.');
      return;
    }

    if (!candidateId) {
      alert('Please log in to upload your CV.');
      return;
    }

    setIsUploading(true);
    try {
      const token = localStorage.getItem('authToken');
      const formData = new FormData();
      formData.append('cvFile', selectedFile);

      const response = await fetch('/api/cv-builder/upload', {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${token}`
        },
        body: formData,
      });

      const data = await response.json();

      if (response.ok && data.success) {
        // Refresh order status to get updated data
        await fetchOrderStatus();
        
        setShowUploadModal(false);
        setSuccessMessage('CV uploaded successfully! Our HR team will process it within 24-72 hours.');
        setSuccessType('upload');
        setShowSuccessModal(true);
        setSelectedFile(null);
      } else {
        // Show error in a better way - could use a toast or error modal
        const errorMessage = data.error || 'Failed to upload CV. Please try again.';
        alert(errorMessage); // TODO: Replace with proper error modal/toast
      }
    } catch (error: any) {
      alert('An error occurred while uploading. Please try again.');
    } finally {
      setIsUploading(false);
    }
  };


  // Show shimmer loading state
  if (isLoadingOrder) {
    return (
      <CandidateLayout>
        <div className="w-full space-y-6">
          {/* Header Shimmer */}
          <div className="bg-gradient-to-r from-[#114373] via-[#1a4d7a] to-[#114373] rounded-2xl shadow-lg p-8 text-white relative overflow-hidden">
            <div className="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full -mr-32 -mt-32 blur-3xl"></div>
            <div className="absolute bottom-0 left-0 w-48 h-48 bg-white/5 rounded-full -ml-24 -mb-24 blur-2xl"></div>
            <div className="relative z-10">
              <div className="h-8 w-64 bg-white/20 rounded-lg mb-3 animate-shimmer"></div>
              <div className="h-5 w-96 bg-white/20 rounded-lg animate-shimmer"></div>
            </div>
          </div>

          {/* Stats Cards Shimmer */}
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            {Array.from({ length: 3 }).map((_, index) => (
              <div key={index} className="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                <div className="flex items-center gap-4">
                  <div className="w-12 h-12 bg-gray-200 rounded-lg animate-shimmer"></div>
                  <div className="flex-1 space-y-2">
                    <div className="h-7 w-16 bg-gray-200 rounded animate-shimmer"></div>
                    <div className="h-4 w-24 bg-gray-200 rounded animate-shimmer"></div>
                  </div>
                </div>
              </div>
            ))}
          </div>

          {/* Main Content Shimmer */}
          <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
            {/* Orders Section Shimmer */}
            <div className="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-200 p-6">
              <div className="h-6 w-40 bg-gray-200 rounded mb-6 animate-shimmer"></div>
              <div className="space-y-4">
                {Array.from({ length: 3 }).map((_, index) => (
                  <div key={index} className="border border-gray-200 rounded-lg p-5">
                    <div className="flex items-start justify-between mb-4">
                      <div className="space-y-2 flex-1">
                        <div className="h-5 w-48 bg-gray-200 rounded animate-shimmer"></div>
                        <div className="h-4 w-32 bg-gray-200 rounded animate-shimmer"></div>
                      </div>
                      <div className="h-6 w-20 bg-gray-200 rounded-full animate-shimmer"></div>
                    </div>
                    <div className="grid grid-cols-2 gap-4">
                      <div className="h-4 w-24 bg-gray-200 rounded animate-shimmer"></div>
                      <div className="h-4 w-28 bg-gray-200 rounded animate-shimmer"></div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            {/* Order New CV Section Shimmer */}
            <div className="lg:col-span-1 bg-white rounded-xl shadow-sm border border-gray-200 p-6">
              <div className="h-6 w-36 bg-gray-200 rounded mb-4 animate-shimmer"></div>
              <div className="space-y-4">
                {Array.from({ length: 4 }).map((_, index) => (
                  <div key={index} className="h-4 w-full bg-gray-200 rounded animate-shimmer"></div>
                ))}
              </div>
              <div className="h-12 w-full bg-gray-200 rounded-lg mt-6 animate-shimmer"></div>
            </div>
          </div>
        </div>
      </CandidateLayout>
    );
  }

  // Determine UI state from latest order
  const latestOrder = orderStatus?.latestOrder;
  const showUploadInterface = latestOrder?.paymentStatus === 'completed' && latestOrder.canUpload;
  const showProcessingStatus = latestOrder?.paymentStatus === 'completed' && latestOrder.cvFilePath && !latestOrder.hasProcessedCv;
  const showCompletedStatus = latestOrder?.hasProcessedCv;
  const allOrders = orderStatus?.orders || [];

  // Helper function to format date
  const formatDate = (dateString: string) => {
    if (!dateString) return 'N/A';
    const date = new Date(dateString);
    return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  };

  // Helper function to get status badge
  const getStatusBadge = (order: any) => {
    if (order.paymentStatus === 'pending') {
      return <span className="px-3 py-1 bg-yellow-100 text-yellow-800 rounded-full text-xs font-semibold flex items-center gap-1 w-fit"><Clock className="w-3 h-3" />Pending</span>;
    }
    if (order.paymentStatus === 'completed' && !order.cvFilePath) {
      return <span className="px-3 py-1 bg-green-100 text-green-800 rounded-full text-xs font-semibold flex items-center gap-1 w-fit"><CheckCircle className="w-3 h-3" />Ready to Upload</span>;
    }
    if (order.paymentStatus === 'completed' && order.cvFilePath && !order.hasProcessedCv) {
      return <span className="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-xs font-semibold flex items-center gap-1 w-fit"><Loader2 className="w-3 h-3 animate-spin" />Processing</span>;
    }
    if (order.hasProcessedCv) {
      return <span className="px-3 py-1 bg-green-100 text-green-800 rounded-full text-xs font-semibold flex items-center gap-1 w-fit"><CheckCircle className="w-3 h-3" />Completed</span>;
    }
    return <span className="px-3 py-1 bg-gray-100 text-gray-800 rounded-full text-xs font-semibold">{order.paymentStatus}</span>;
  };

  return (
    <CandidateLayout>
      <div className="w-full space-y-6">
          {/* Header Section */}
          <div className="mb-8">
            <div className="flex items-center justify-between mb-4">
              <div>
                <h1 className="text-3xl font-bold text-gray-900 mb-2">Professional CV Builder</h1>
                <p className="text-gray-600">
                  Get professionally crafted CVs by our HR experts. Order multiple CVs anytime.
                </p>
              </div>
              <div className="hidden md:flex items-center gap-2 bg-white px-4 py-2 rounded-lg shadow-sm border border-gray-200">
                <DollarSign className="w-5 h-5 text-[#114373]" />
                <div>
                  <div className="text-xs text-gray-500">Price per CV</div>
                  <div className="text-sm font-bold text-gray-900">{formattedTZS}</div>
                </div>
              </div>
            </div>
          </div>

          {/* Stats Cards */}
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
            <div className="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
              <div className="flex items-center gap-4">
                <div className="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg flex items-center justify-center">
                  <FileText className="w-6 h-6 text-white" />
                </div>
                <div>
                  <div className="text-2xl font-bold text-gray-900">{allOrders.length}</div>
                  <div className="text-sm text-gray-600">Total Orders</div>
                </div>
              </div>
            </div>
            <div className="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
              <div className="flex items-center gap-4">
                <div className="w-12 h-12 bg-gradient-to-br from-green-500 to-green-600 rounded-lg flex items-center justify-center">
                  <CheckCircle className="w-6 h-6 text-white" />
                </div>
                <div>
                  <div className="text-2xl font-bold text-gray-900">
                    {allOrders.filter((o: any) => o.hasProcessedCv).length}
                  </div>
                  <div className="text-sm text-gray-600">Completed</div>
                </div>
              </div>
            </div>
            <div className="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
              <div className="flex items-center gap-4">
                <div className="w-12 h-12 bg-gradient-to-br from-yellow-500 to-orange-500 rounded-lg flex items-center justify-center">
                  <Clock className="w-6 h-6 text-white" />
                </div>
                <div>
                  <div className="text-2xl font-bold text-gray-900">
                    {allOrders.filter((o: any) => o.paymentStatus === 'completed' && o.cvFilePath && !o.hasProcessedCv).length}
                  </div>
                  <div className="text-sm text-gray-600">In Progress</div>
                </div>
              </div>
            </div>
          </div>

          {/* Main Content Grid */}
          <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
            {/* Left Column - CV Orders */}
            <div className="lg:col-span-2 space-y-6">
              {/* My CV Orders Section */}
              <div className="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                <div className="flex items-center justify-between mb-6">
                  <h2 className="text-xl font-bold text-gray-900 flex items-center gap-2">
                    <FileText className="w-5 h-5 text-[#114373]" />
                    My CV Orders
                  </h2>
                  <button
                    onClick={fetchOrderStatus}
                    className="p-2 hover:bg-gray-100 rounded-lg transition-colors"
                    title="Refresh"
                  >
                    <RefreshCw className="w-4 h-4 text-gray-600" />
                  </button>
                </div>

                {allOrders.length === 0 ? (
                  <div className="text-center py-12">
                    <div className="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                      <FileText className="w-8 h-8 text-gray-400" />
                    </div>
                    <h3 className="text-lg font-semibold text-gray-900 mb-2">No CV Orders Yet</h3>
                    <p className="text-gray-600 mb-6">Order your first professional CV below</p>
                  </div>
                ) : (
                  <div className="space-y-4">
                    {allOrders.map((order: any) => (
                      <div key={order.id} className="border border-gray-200 rounded-lg p-5 hover:shadow-md transition-shadow">
                        <div className="flex items-start justify-between mb-4">
                          <div className="flex-1">
                            <div className="flex items-center gap-3 mb-2">
                              <h3 className="font-semibold text-gray-900">
                                {order.candidateName || `CV Order #${order.id}`}
                              </h3>
                              {getStatusBadge(order)}
                            </div>
                            <div className="flex items-center gap-4 text-sm text-gray-600">
                              <div className="flex items-center gap-1">
                                <Calendar className="w-4 h-4" />
                                {formatDate(order.createdAt)}
                              </div>
                              <div className="flex items-center gap-1">
                                <DollarSign className="w-4 h-4" />
                                {new Intl.NumberFormat('en-TZ', { style: 'currency', currency: 'TZS', minimumFractionDigits: 0 }).format(order.amountTZS)}
                              </div>
                            </div>
                          </div>
                        </div>

                        {/* Order Actions */}
                        <div className="flex items-center gap-2 flex-wrap">
                          {order.paymentStatus === 'completed' && order.canUpload && (
                            <button
                              onClick={() => {
                                setSelectedFile(null);
                                setShowUploadModal(true);
                              }}
                              className="px-4 py-2 bg-[#114373] text-white rounded-lg hover:bg-[#0d3559] transition-colors text-sm font-semibold flex items-center gap-2"
                            >
                              <Upload className="w-4 h-4" />
                              Upload CV
                            </button>
                          )}
                          {order.paymentStatus === 'completed' && order.cvFilePath && !order.hasProcessedCv && (
                            <div className="px-4 py-2 bg-blue-50 text-blue-800 rounded-lg text-sm font-semibold flex items-center gap-2">
                              <Loader2 className="w-4 h-4 animate-spin" />
                              Processing...
                            </div>
                          )}
                          {order.hasProcessedCv && order.processedCvPath && (
                            <a
                              href={order.processedCvPath}
                              download
                              className="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors text-sm font-semibold flex items-center gap-2"
                            >
                              <Download className="w-4 h-4" />
                              Download CV
                            </a>
                          )}
                          {order.paymentStatus === 'pending' && (
                            <div className="px-4 py-2 bg-yellow-50 text-yellow-800 rounded-lg text-sm font-semibold flex items-center gap-2">
                              <Clock className="w-4 h-4" />
                              Payment Pending
                            </div>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>

            {/* Right Column - Order New CV */}
            <div className="lg:col-span-1">
              <div className="bg-white rounded-xl shadow-sm border border-gray-200 p-5 sticky top-6">
                <div className="text-center mb-5">
                  <div className="w-14 h-14 bg-gradient-to-br from-[#114373] to-[#0d3559] rounded-full flex items-center justify-center mx-auto mb-3">
                    <Sparkles className="w-7 h-7 text-white" />
                  </div>
                  <h2 className="text-lg font-bold text-gray-900 mb-1">Order New CV</h2>
                  <p className="text-xs text-gray-600">
                    Get a professionally crafted CV by our HR experts
                  </p>
                </div>

                {/* Features */}
                <div className="space-y-2 mb-5">
                  <div className="flex items-center gap-2 text-xs text-gray-700">
                    <CheckCircle className="w-3.5 h-3.5 text-green-500 flex-shrink-0" />
                    <span>Professional HR expertise</span>
                  </div>
                  <div className="flex items-center gap-2 text-xs text-gray-700">
                    <CheckCircle className="w-3.5 h-3.5 text-green-500 flex-shrink-0" />
                    <span>ATS-optimized format</span>
                  </div>
                  <div className="flex items-center gap-2 text-xs text-gray-700">
                    <CheckCircle className="w-3.5 h-3.5 text-green-500 flex-shrink-0" />
                    <span>24-72 hour delivery</span>
                  </div>
                  <div className="flex items-center gap-2 text-xs text-gray-700">
                    <CheckCircle className="w-3.5 h-3.5 text-green-500 flex-shrink-0" />
                    <span>Email notifications</span>
                  </div>
                </div>

                {/* Pricing */}
                <div className="bg-gradient-to-r from-[#114373]/10 to-[#0d3559]/10 rounded-lg p-3 mb-5">
                  <div className="text-center">
                    <div className="text-2xl font-bold text-[#114373] mb-1">{formattedTZS}</div>
                    <div className="text-base text-gray-700 mb-1">{formattedUSD}</div>
                    <div className="text-xs text-gray-500">One-time payment</div>
                  </div>
                </div>

                {/* Order Button */}
                <button
                  onClick={() => setShowPaymentModal(true)}
                  disabled={!candidateId || isProcessingPayment}
                  className="w-full bg-gradient-to-r from-[#114373] to-[#0d3559] text-white py-2.5 px-4 rounded-lg font-semibold text-sm hover:from-[#0d3559] hover:to-[#114373] transition-all duration-300 shadow-lg disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
                >
                  {isProcessingPayment ? (
                    <>
                      <Loader2 className="w-4 h-4 animate-spin" />
                      Processing...
                    </>
                  ) : (
                    <>
                      <Plus className="w-4 h-4" />
                      Order New CV
                    </>
                  )}
                </button>

                <div className="mt-3 text-center">
                  <p className="text-xs text-gray-500">
                    Secure payment via Stripe
                  </p>
                </div>
              </div>
            </div>
          </div>


          {/* Payment Modal */}
          {showPaymentModal && (
            <div className="fixed inset-0 bg-gray-900/20 backdrop-blur-sm flex items-center justify-center z-50 p-4">
              <div className="bg-white rounded-xl p-6 w-full max-w-md shadow-2xl border border-gray-200">
                <div className="text-center mb-6">
                  <div className="w-12 h-12 bg-gradient-to-br from-[#114373] to-[#0d3559] rounded-full flex items-center justify-center mx-auto mb-3">
                    <CreditCard className="w-6 h-6 text-white" />
                  </div>
                  <h3 className="text-xl font-bold text-gray-900 mb-2">Secure Payment</h3>
                  <p className="text-sm text-gray-600">Pay securely via Stripe to generate your professional CV</p>
                </div>

                <div className="bg-gradient-to-r from-[#114373]/10 to-[#0d3559]/10 rounded-lg p-6 mb-6">
                  <div className="text-center">
                    <div className="text-3xl font-bold text-[#114373] mb-2">{formattedTZS}</div>
                    <div className="text-xl text-gray-700 mb-1">{formattedUSD}</div>
                    <div className="text-sm text-gray-600">Professional CV Generation</div>
                    <div className="text-xs text-gray-500 mt-2">
                      Payment will be processed in USD via Stripe
                    </div>
                  </div>
                </div>

                <div className="bg-blue-50 rounded-lg p-4 mb-6">
                  <div className="flex items-start gap-3">
                    <Shield className="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5" />
                    <div>
                      <h4 className="font-semibold text-blue-900 text-sm mb-1">Secure Payment</h4>
                      <p className="text-xs text-blue-800">
                        Your payment is processed securely through Stripe. We accept all major credit and debit cards.
                      </p>
                    </div>
                  </div>
                </div>

                <div className="space-y-3">
                  <button
                    onClick={handlePayment}
                    disabled={isProcessingPayment || !candidateId}
                    className="w-full bg-[#114373] text-white py-3 px-4 rounded-lg font-semibold text-sm hover:bg-[#0d3559] transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
                  >
                    {isProcessingPayment ? (
                      <>
                        <Loader2 className="w-4 h-4 animate-spin" />
                        Processing...
                      </>
                    ) : (
                      <>
                        <CreditCard className="w-4 h-4" />
                        Pay with Stripe
                      </>
                    )}
                  </button>
                  <button
                    onClick={() => setShowPaymentModal(false)}
                    disabled={isProcessingPayment}
                    className="w-full border border-gray-300 text-gray-700 py-2 px-4 rounded-lg font-semibold text-sm hover:bg-gray-50 transition-colors disabled:opacity-50"
                  >
                    Cancel
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* Upload Modal */}
          {showUploadModal && (
            <div className="fixed inset-0 backdrop-blur-[2px] flex items-center justify-center z-50 p-4">
              <div className="bg-white rounded-xl p-6 w-full max-w-2xl shadow-2xl border border-gray-200">
                <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                  {/* Left Column - Instructions */}
                  <div className="space-y-4">
                    <div className="text-center lg:text-left">
                      <div className="w-12 h-12 bg-gradient-to-br from-green-400 to-blue-500 rounded-full flex items-center justify-center mx-auto lg:mx-0 mb-3">
                        <Upload className="w-6 h-6 text-white" />
                      </div>
                      <h3 className="text-xl font-bold text-gray-900 mb-2">Upload Your Profile CV</h3>
                      <p className="text-sm text-gray-600">
                        Upload the CV you created and downloaded from your profile page.
                      </p>
                    </div>

                    <div className="bg-blue-50 rounded-lg p-3">
                      <div className="flex items-start gap-2">
                        <div className="w-5 h-5 bg-blue-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                          <span className="text-white text-xs font-bold">i</span>
                        </div>
                        <div>
                          <h4 className="font-semibold text-blue-900 text-sm mb-1">Important</h4>
                          <p className="text-xs text-blue-800">
                            Download your CV from the profile page first, then upload it here.
                          </p>
                        </div>
                      </div>
                    </div>

                    <div className="bg-green-50 rounded-lg p-3">
                      <div className="flex items-start gap-2">
                        <Clock className="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" />
                        <div>
                          <h4 className="font-semibold text-green-900 text-sm mb-1">Timeline</h4>
                          <p className="text-xs text-green-800">
                            Processed within 24-72 hours. Email notification when ready.
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>

                  {/* Right Column - Upload Area */}
                  <div className="space-y-4">
                    <div className="border-2 border-dashed border-gray-300 rounded-lg p-4 text-center">
                      <Upload className="w-8 h-8 text-gray-400 mx-auto mb-3" />
                      <p className="text-sm text-gray-600 mb-3">Drag and drop your CV file here</p>
                      <input
                        type="file"
                        accept=".pdf,.doc,.docx"
                        onChange={handleFileUpload}
                        className="hidden"
                        id="cv-upload"
                      />
                      <label
                        htmlFor="cv-upload"
                        className="bg-[#114373] text-white py-2 px-4 rounded-lg cursor-pointer hover:bg-[#0d3559] transition-colors text-sm font-semibold inline-block"
                      >
                        Choose File
                      </label>
                      {selectedFile && (
                        <p className="text-xs text-gray-600 mt-2">Selected: {selectedFile.name}</p>
                      )}
                    </div>

                    <div className="space-y-2">
                      <button
                        onClick={handleUploadCV}
                        disabled={!selectedFile || isUploading}
                        className="w-full bg-[#114373] text-white py-2 px-4 rounded-lg font-semibold text-sm hover:bg-[#0d3559] transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
                      >
                        {isUploading ? (
                          <>
                            <Loader2 className="w-4 h-4 animate-spin" />
                            Uploading...
                          </>
                        ) : (
                          'Submit for Processing'
                        )}
                      </button>
                      <button
                        onClick={() => setShowUploadModal(false)}
                        className="w-full border border-gray-300 text-gray-700 py-2 px-4 rounded-lg font-semibold text-sm hover:bg-gray-50 transition-colors"
                      >
                        Cancel
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* Success Modal */}
          {showSuccessModal && (
            <div className="fixed inset-0 bg-gray-900/20 backdrop-blur-sm flex items-center justify-center z-50 p-4">
              <div className="bg-white rounded-xl p-8 w-full max-w-md shadow-2xl border border-gray-200">
                <div className="text-center">
                  <div className="w-16 h-16 bg-gradient-to-br from-green-400 to-green-600 rounded-full flex items-center justify-center mx-auto mb-6">
                    <CheckCircle className="w-8 h-8 text-white" />
                  </div>
                  {successType === 'payment' ? (
                    <>
                      <h3 className="text-2xl font-bold text-gray-900 mb-4">Payment Successful!</h3>
                      <p className="text-gray-600 mb-6">
                        Your payment has been processed successfully. You can now upload your CV for professional generation.
                      </p>
                      <div className="bg-green-50 rounded-lg p-4 mb-6">
                        <div className="flex items-center gap-3 mb-2">
                          <Clock className="w-5 h-5 text-green-600" />
                          <span className="font-semibold text-green-900">Next Steps</span>
                        </div>
                        <p className="text-sm text-green-800 text-left">
                          1. Upload your current CV<br/>
                          2. Our HR experts will review and enhance it<br/>
                          3. Receive your professional CV within 24-72 hours
                        </p>
                      </div>
                      <div className="space-y-3">
                        <button
                          onClick={() => {
                            setShowSuccessModal(false);
                            setShowUploadModal(true);
                          }}
                          className="w-full bg-[#114373] text-white py-3 px-6 rounded-lg font-semibold hover:bg-[#0d3559] transition-colors"
                        >
                          Upload CV Now
                        </button>
                        <button
                          onClick={() => setShowSuccessModal(false)}
                          className="w-full border border-gray-300 text-gray-700 py-2 px-4 rounded-lg font-semibold hover:bg-gray-50 transition-colors"
                        >
                          Upload Later
                        </button>
                      </div>
                    </>
                  ) : (
                    <>
                      <h3 className="text-2xl font-bold text-gray-900 mb-4">CV Uploaded Successfully!</h3>
                      <p className="text-gray-600 mb-6">
                        {successMessage}
                      </p>
                      <div className="bg-blue-50 rounded-lg p-4 mb-6">
                        <div className="flex items-center gap-3 mb-2">
                          <Clock className="w-5 h-5 text-blue-600" />
                          <span className="font-semibold text-blue-900">What Happens Next?</span>
                        </div>
                        <p className="text-sm text-blue-800 text-left">
                          • Our HR team will review your CV<br/>
                          • They'll enhance it with professional formatting<br/>
                          • You'll receive an email when it's ready<br/>
                          • Processing time: 24-72 hours
                        </p>
                      </div>
                      <div className="bg-green-50 rounded-lg p-4 mb-6">
                        <div className="flex items-center gap-3 mb-2">
                          <CheckCircle className="w-5 h-5 text-green-600" />
                          <span className="font-semibold text-green-900">Thank You!</span>
                        </div>
                        <p className="text-sm text-green-800">
                          We'll notify you via email once your professional CV is ready for download.
                        </p>
                      </div>
                      <button
                        onClick={() => {
                          setShowSuccessModal(false);
                          // Refresh order status to show processing state
                          fetchOrderStatus();
                        }}
                        className="w-full bg-[#114373] text-white py-3 px-6 rounded-lg font-semibold hover:bg-[#0d3559] transition-colors"
                      >
                        Got it, thanks!
                      </button>
                    </>
                  )}
                </div>
              </div>
            </div>
          )}
        </div>
    </CandidateLayout>
  );
}